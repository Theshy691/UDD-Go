# Leave empty for the local demo. These are public browser credentials, never service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: CARTO Positron requires a basemap key. Without it, OpenStreetMap is used.
VITE_CARTO_API_KEY=
# PHP runtime alternatives (Docker / PHP hosting):
SUPABASE_URL=
SUPABASE_ANON_KEY=
CARTO_API_KEY=
